# =============================================================================
# Paříž 27 – proměnné prostředí
# =============================================================================
# Zkopírujte tento soubor jako .env.local (pro spuštění na počítači)
# a stejné hodnoty zadejte ve Vercelu: Project → Settings → Environment Variables.
#
# Hodnoty najdete v Supabase: Project Settings → API (Data API / API Keys).
# Soubor .env.local se NIKDY nenahrává do gitu (je v .gitignore).

# Adresa projektu Supabase, např. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Veřejný klíč pro prohlížeč – „anon public“ (eyJ…) nebo novější „publishable“ (sb_publishable_…).
# Je určený do aplikace v prohlížeči; data chrání Row Level Security v databázi.
# NIKDY sem nevkládejte „service_role“ ani „secret“ klíč!
VITE_SUPABASE_ANON_KEY=
